# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Database (Supabase Postgres) ─────────────────────────────
# Runtime: TRANSACTION POOLER (port 6543, must end with ?pgbouncer=true).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: DIRECT connection (port 5432, no pgbouncer).
# Local Docker dev: set both to postgresql://ziganya:ziganya@localhost:5432/ziganya?schema=public
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Redis (Upstash, TLS) ─────────────────────────────────────
# Managed URLs (rediss:// or *.upstash.io) auto-enable TLS.
REDIS_URL=redis://default:[password]@your-instance.upstash.io:6379
# Local Docker dev alternative (used only when REDIS_URL is unset):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Supabase API + Storage ───────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=ziganya-media

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Push notifications (Firebase) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes inside the quotes; code converts them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── SMS / WhatsApp (Twilio) ──────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=

# ── JWT ──────────────────────────────────────────────────────
# One signing secret (generate a random 64-char string).
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# ── Security ─────────────────────────────────────────────────
BCRYPT_COST=12
